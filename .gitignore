# ── Credentials & secrets ──────────────────────────────────────────────────────
# NEVER commit these
.env.local
.env*.local
.env
.env.*
teleplan/.env
teleplan/.env.*
hlink/.env
hlink/.env.*

# ── Teleplan runtime state ─────────────────────────────────────────────────────
teleplan/.seqnum

# ── Node modules ───────────────────────────────────────────────────────────────
teleplan/node_modules/
hlink/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Conformance proof bundles (private test submission data) ───────────────────
# These contain real HIBC/AHCIP test PHNs and submission records.
# Keep locally; share with HIBC/AHCIP directly, not via public repo.
teleplan/conformance-proof/
hlink/conformance-proof/
mcedt/conformance-results/
mcedt/conformance-results -/
hcv/hcv-results/
hcv/hcv-results -/

# ── MCEDT / HCV signing key pair ───────────────────────────────────────────────
# Generated locally; ebs_signing.crt is safe to share with MOH for response
# encryption. ebs_signing.key MUST NEVER be committed.
mcedt/ebs_signing.key
mcedt/ebs_signing.crt

# ── Python cache ────────────────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc

# ── OS & editor artefacts ──────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
*.swp
*.swo

# ── TypeScript incremental build cache ─────────────────────────────────────────
tsconfig.tsbuildinfo
*.tsbuildinfo

# ── Logs & temporaries ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
